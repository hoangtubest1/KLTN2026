# ===========================
# SERVER CONFIGURATION
# ===========================
PORT=5000
NODE_ENV=development

# ===========================
# DATABASE (MySQL)
# ===========================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=booking_db
DB_USER=root
DB_PASSWORD=your_mysql_password

# ===========================
# JWT SECRET
# ===========================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_this_in_production

# ===========================
# EMAIL SERVICE
# ===========================
# Cách 1 — SMTP (Gmail: dùng "Mật khẩu ứng dụng", không dùng mật khẩu đăng nhập thường)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_16_char_app_password
EMAIL_FROM="Tìm Sân <your_email@gmail.com>"
# EMAIL_FROM nên cùng domain / cùng tài khoản gửi để tránh spam

# Cách 2 — Resend (Railway/production, không cần SMTP)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM=Sports Booking <onboarding@resend.dev>

# ===========================
# VNPay CONFIGURATION
# ===========================
VNPAY_TMN_CODE=your_tmn_code
VNPAY_HASH_SECRET=your_hash_secret
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payment-return

# ===========================
# MoMo CONFIGURATION
# ===========================
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_PARTNER_CODE=your_partner_code
MOMO_ACCESS_KEY=your_access_key
MOMO_SECRET_KEY=your_secret_key
MOMO_RETURN_URL=http://localhost:3000/momo-return

# ===========================
# GOOGLE Gemini AI
# ===========================
GEMINI_API_KEY=your_gemini_api_key

# ===========================
# FRONTEND URL (CORS)
# ===========================
CLIENT_URL=http://localhost:3000
